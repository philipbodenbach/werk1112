  "uid": "werk-observability",
  "title": "WERK1112 \u00b7 Inference Observatory",
  "tags": [
    "werk",
    "inference"
  ],
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "timezone": "browser",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Decode \u00b7 current estimate",
      "description": "Native context growth estimate, single active request only. Gaps are unavailable samples.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "werk_backend_decode_tokens_per_second_estimate{job=\"werk\"}",
          "legendFormat": "{{instance}} {{model}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:tok/s",
          "color": {
            "mode": "fixed",
            "fixedColor": "#00DCFF"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 12,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },

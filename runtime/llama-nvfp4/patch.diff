diff --git a/ggml/src/ggml-cuda/werk-marlin.cu b/ggml/src/ggml-cuda/werk-marlin.cu
new file mode 100644
index 000000000..245563706
--- /dev/null
+++ b/ggml/src/ggml-cuda/werk-marlin.cu
@@ -0,0 +1,68 @@
+// Copyright (c) 2026 WERK contributors. Elastic License 2.0 (adapter); vendored kernels Apache-2.0.
+#include "werk-marlin.cuh"
+#include <cuda_fp8.h>
+#if !defined(__CUDA_ARCH__) || __CUDA_ARCH__ >= 800
+#include "werk-marlin/marlin_template.h"
+#endif
+#include <stdexcept>
+
+__device__ static unsigned werk_q(const werk_nvfp4_block * src, int n, int k, int width) {
+    const werk_nvfp4_block & b = src[int64_t(n) * (width / 64) + k / 64];
+    const int q = k % 64;
+    return (b.qs[(q / 16) * 8 + q % 8] >> ((q % 16 / 8) * 4)) & 15;
+}
+// Equivalent to GPTQ Marlin repacking, directly from GGUF: no full intermediary.
+__global__ static void werk_pack(const werk_nvfp4_block * src, uint32_t * dst, werk_activation * scales,
+                                int n, int k, const int * bounds, int expert) {
+    if (bounds && bounds[expert] == bounds[expert + 1]) return;
+    int64_t i = int64_t(blockIdx.x) * blockDim.x + threadIdx.x;
+    if (i < int64_t(n) * k / 8) {
+        int tile = i / 128, lane = (i % 128) / 4, warp = i % 4;
+        int kn = tile / (n / 64) * 16, nn = tile % (n / 64) * 64 + warp * 16 + lane / 4;
+        int kr = kn + (lane % 4) * 2;
+        const int rows[8] = {0,8,0,8,1,9,1,9};
+        const int cols[8] = {0,0,8,8,0,0,8,8};
+        uint32_t q = 0;
+        #pragma unroll
+        for (int j=0;j<8;++j) q |= werk_q(src,nn+cols[j],kr+rows[j],k) << (j*4);
+        dst[i] = q;
+    }
+    if (i < int64_t(n) * k / 16) {
+        // Standard Marlin BF16 scale permutation. Expanding UE4M3 to BF16
+        // preserves tiny scales, unlike the upstream NVFP4 S0E5M3 shortcut.
+        int64_t orig = (i / 64) * 64 + (i % 64) / 8 + (i % 8) * 8;
+        int col = orig % n, group = orig / n;
+        uint8_t q = src[int64_t(col) * (k / 64) + group / 4].d[group % 4];
+        __nv_fp8_e4m3 fp8; fp8.__x = q;
+        scales[i] = static_cast<werk_activation>(fp8);
+    }
+}
+bool werk_marlin_shape(int n, int k) {
+    return n > 0 && k > 0 && ((n % 64 == 0 && k % 128 == 0) || (n % 128 == 0 && k % 64 == 0));
+}
+void werk_marlin_repack(const werk_nvfp4_block * src, uint32_t * weights, werk_activation * scales,
+                       int n, int k, const int * bounds, int expert, cudaStream_t stream) {
+    werk_pack<<<(int64_t(n)*k/8+255)/256,256,0,stream>>>(src,weights,scales,n,k,bounds,expert);
+}
+template<int NB, int KB>
+static void werk_launch(const werk_activation * a, const uint32_t * b, const werk_activation * scales, float * c,
+                        float * reduce, int * locks, int m, int n, int k, int sms,
+                        const int * bounds, int expert, cudaStream_t stream) {
+#if !defined(__CUDA_ARCH__) || __CUDA_ARCH__ >= 800
+    auto kernel = marlin::Marlin<vllm::kBFloat16.id(),vllm::kFE2M1f.id(),vllm::kBFloat16.id(),
+                                 vllm::kBFloat16.id(),128,1,NB,KB,false,4,1,false>;
+    constexpr int shared = 48 * 1024;
+    cudaError_t err = cudaFuncSetAttribute(kernel,cudaFuncAttributeMaxDynamicSharedMemorySize,shared);
+    if (err != cudaSuccess) throw std::runtime_error(cudaGetErrorString(err));
+    for (bool tail : {false,true}) {
+        kernel<<<sms,128,shared,stream>>>((const int4*)a,(const int4*)b,(int4*)c,(int4*)reduce,
+            nullptr,nullptr,(const int4*)scales,nullptr,nullptr,m,n,k,k,locks,false,false,true,shared,bounds,expert,tail,c);
+    }
+#endif
+}
+void werk_marlin_mm(const werk_activation * a, const uint32_t * b, const werk_activation * scales, float * c,
+                    float * reduce, int * locks, int m, int n, int k, int sms,
+                    const int * bounds, int expert, cudaStream_t stream) {
+    if (k % 128 == 0) werk_launch<4,8>(a,b,scales,c,reduce,locks,m,n,k,sms,bounds,expert,stream);
+    else werk_launch<8,4>(a,b,scales,c,reduce,locks,m,n,k,sms,bounds,expert,stream);
+}
diff --git a/ggml/src/ggml-cuda/werk-marlin.cuh b/ggml/src/ggml-cuda/werk-marlin.cuh
new file mode 100644
index 000000000..16bdfa6e4
--- /dev/null
+++ b/ggml/src/ggml-cuda/werk-marlin.cuh
@@ -0,0 +1,14 @@
+#pragma once
+#include <cuda_runtime.h>
+#include <cuda_bf16.h>
+using werk_activation = nv_bfloat16;
+#include <cstdint>
+// GGML block_nvfp4: four UE4M3 scales, four groups of 16 E2M1 values.
+struct werk_nvfp4_block { uint8_t d[4]; uint8_t qs[32]; };
+static_assert(sizeof(werk_nvfp4_block) == 36, "NVFP4 block ABI");
+bool werk_marlin_shape(int n, int k);
+void werk_marlin_repack(const werk_nvfp4_block * src, uint32_t * weights, werk_activation * scales,
+                       int n, int k, const int * bounds, int expert, cudaStream_t stream);
+void werk_marlin_mm(const werk_activation * a, const uint32_t * b, const werk_activation * scales, float * c,
+                    float * reduce, int * locks, int m, int n, int k, int sms,
+                    const int * bounds, int expert, cudaStream_t stream);

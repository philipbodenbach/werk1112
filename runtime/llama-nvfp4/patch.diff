+    return true;
+}
+// Query an actually loaded image, not only arch <= device: a real-only cubin
+// from an older major architecture is not forward-compatible without PTX.
+__global__ static void werk_probe_image(int * architecture) {
+#ifdef __CUDA_ARCH__
+    *architecture = __CUDA_ARCH__;
+#else
+    *architecture = 0;
+#endif
+}
+static int werk_loaded_arch(int device, cudaError_t & status) {
+    int * memory = nullptr;
+    int architecture = 0;
+    status = cudaSetDevice(device);
+    if (status == cudaSuccess) status = cudaMalloc(&memory, sizeof(int));
+    if (status == cudaSuccess) {
+        werk_probe_image<<<1,1>>>(memory);
+        status = cudaGetLastError();
+        if (status == cudaSuccess) status = cudaMemcpy(&architecture, memory, sizeof(int), cudaMemcpyDeviceToHost);
+    }
+    if (memory) cudaFree(memory);
+    return status == cudaSuccess ? architecture : 0;
+}
+extern "C" GGML_BACKEND_API const char * ggml_cuda_werk_fp4_capabilities() {
+    static thread_local std::string result;
+    int count=0;
+    cudaError_t status=cudaGetDeviceCount(&count);
+    if(status!=cudaSuccess) count=0;
+    bool any_native_build=false;
+    for(int arch : {1200,1210}) any_native_build |= ggml_cuda_highest_compiled_arch(arch)>=1200;
+    const bool marlin_build = ggml_cuda_highest_compiled_arch(GGML_CUDA_CC_RUBIN) >= 800;
+    std::ostringstream out;
+    out << "{\"schema\":1,\"kernel_abi\":\"werk-nvfp4-v1\",\"revision\":\"fc343a84bbd925b37dde3219de35ea0bed50d630\",\"marlin\":" << (marlin_build?"true":"false") << ",\"native\":"
+        << (any_native_build?"true":"false") << ",\"operations\":[\"mul_mat\",\"mul_mat_id\"],\"marlin_activation\":\"bf16\",\"native_activation\":\"fp4\",\"devices\":[";
+    for(int i=0;i<count;++i) {
+        cudaDeviceProp prop{};
+        CUDA_CHECK(cudaGetDeviceProperties(&prop,i));
+        const int cc=prop.major*100+prop.minor*10;
+        cudaError_t probe_status = cudaSuccess;
+        const int loaded_arch = werk_loaded_arch(i, probe_status);
+        const bool marlin=cc>=800 && loaded_arch>=800;
+        const bool native=cc>=1200 && cc<1300 && loaded_arch>=1200 && loaded_arch<1300;
+        if(i) out << ',';
+        out << "{\"index\":" << i << ",\"compute_capability\":" << prop.major*10+prop.minor
+            << ",\"compiled_arch\":" << loaded_arch / 10 << ",\"loaded_cuda_arch\":" << loaded_arch << ",\"probe_cuda_error\":" << int(probe_status)
+            << ",\"native_nvfp4\":" << (native?"true":"false") << ",\"marlin_nvfp4\":" << (marlin?"true":"false") << '}';
+    }
+    out << "]}";
+    result=out.str();return result.c_str();
+}

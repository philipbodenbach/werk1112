+#include "ggml.h"
+#include "ggml-backend.h"
+#include "ggml-alloc.h"
+#include <cstring>
+#include "ggml-cuda.h"
+#include <vector>
+#include <cmath>
+#include <cstdio>
+#include <stdexcept>
+#include <algorithm>
+#include <cstdlib>
+struct block { unsigned char d[4],qs[32]; };
+static float f4(int q){const float v[]={0,.5,1,1.5,2,3,4,6};return v[q&7]*(q&8?-1:1);}
+static float f8(int q){return q<8?std::ldexp(float(q),-9):std::ldexp(1.0f+float(q&7)/8,(q>>3)-7);}
+static void run(bool moe,bool broadcast,int tokens,int n,int k,bool strided_a=false,bool strided_out=false,bool fallback=false) {
+    const char * policy=std::getenv("GGML_CUDA_NVFP4_KERNEL");
+    fallback |= policy && !std::strcmp(policy,"ggml");
+    int experts=moe?5:1,used=moe?2:1,ac=moe&&!broadcast?used:1;
+    ggml_backend_t backend=ggml_backend_cuda_init(0);
+    if(!backend)throw std::runtime_error("CUDA backend initialization failed");
+    ggml_init_params params{2*1024*1024,nullptr,true};auto ctx=ggml_init(params);
+    auto w=ggml_new_tensor_3d(ctx,GGML_TYPE_NVFP4,k,n,experts);ggml_set_name(w,"werk_nvfp4_test_weights");
+    int input_stride=k+(strided_a?16:0),output_stride=n+(strided_out?16:0);
+    auto storage=moe?ggml_new_tensor_3d(ctx,GGML_TYPE_F32,input_stride,ac,tokens):ggml_new_tensor_2d(ctx,GGML_TYPE_F32,input_stride,tokens);
+    auto a=storage;
+    if(strided_a) a=moe?ggml_view_3d(ctx,storage,k,ac,tokens,size_t(input_stride)*4,size_t(input_stride)*ac*4,0):ggml_view_2d(ctx,storage,k,tokens,size_t(input_stride)*4,0);
+    auto ids=moe?ggml_new_tensor_2d(ctx,GGML_TYPE_I32,used,tokens):nullptr;
+    auto mm=moe?ggml_mul_mat_id(ctx,w,a,ids):ggml_mul_mat(ctx,w,a);
+    if(strided_out) { mm->nb[1]=size_t(output_stride)*4; mm->nb[2]=mm->nb[1]*mm->ne[1]; mm->nb[3]=mm->nb[2]*mm->ne[2]; }
+    auto result=strided_out?mm:ggml_scale(ctx,mm,0.25f); // scale_2 remains a normal llama graph operation.
+    auto graph=ggml_new_graph(ctx);ggml_build_forward_expand(graph,result);
+    auto buffer=ggml_backend_alloc_ctx_tensors(ctx,backend);
+    if(!buffer)throw std::runtime_error("CUDA allocation failed");
+    std::vector<block> weights(size_t(experts)*n*k/64);
+    std::vector<float> input(size_t(k)*ac*tokens),output(ggml_nbytes(result)/sizeof(float)),input_storage(size_t(input_stride)*ac*tokens);
+    std::vector<int> selection(size_t(used)*tokens);
+    for(size_t i=0;i<input.size();++i)input[i]=float(int((i*37+13)%101)-50)/1000;
+    for(size_t i=0;i<weights.size();++i){for(int g=0;g<4;++g)weights[i].d[g]=(i*13+g*23)%120;for(int q=0;q<32;++q)weights[i].qs[q]=(i*19+q*43+7)%256;}
+    for(int t=0;t<tokens;++t)for(int e=0;e<used;++e)selection[t*used+e]=(t+e)%3; // experts 3,4 empty
+    ggml_backend_tensor_set(w,weights.data(),0,weights.size()*sizeof(block));
+    for(int iteration=0;iteration<4;++iteration) {
+        for(size_t i=0;i<input.size();++i){ input[i]*=-1.01f; input_storage[(i/k)*input_stride+i%k]=input[i]; }
+        for(auto & expert:selection)expert=(expert+1)%3;
+        ggml_backend_tensor_set(storage,input_storage.data(),0,input_storage.size()*sizeof(float));
+        if(ids)ggml_backend_tensor_set(ids,selection.data(),0,selection.size()*sizeof(int));
+        auto status=ggml_backend_graph_compute(backend,graph);
+        if(status!=GGML_STATUS_SUCCESS)throw std::runtime_error("GGML graph failed");
+    }
+    ggml_backend_tensor_get(result,output.data(),0,output.size()*sizeof(float));
+    double e2=0,r2=0;int bad=0;
+    for(int t=0;t<tokens;++t)for(int slot=0;slot<used;++slot)for(int col=0;col<n;++col){
+        int expert=moe?selection[t*used+slot]:0;double ref=0,magnitude=0;
+        for(int j=0;j<k;++j){auto & b=weights[(size_t(expert)*n+col)*k/64+j/64];int qj=j%64,q=(b.qs[qj/16*8+qj%8]>>((qj%16/8)*4))&15;
+            float x=input[(size_t(t)*ac+slot%ac)*k+j];if(!fallback)x=ggml_bf16_to_fp32(ggml_fp32_to_bf16(x));double term=double(x)*f4(q)*f8(b.d[qj/16]);ref+=term;magnitude+=std::abs(term);}
+        ref*=strided_out?1.0:.25;magnitude*=strided_out?1.0:.25;float actual=output[(size_t(t)*used+slot)*output_stride+col];double err=std::abs(actual-ref);e2+=err*err;r2+=ref*ref;
+        if(!std::isfinite(actual)||err>(fallback ? .1+.02*magnitude : .01+.001*std::abs(ref))){if(bad<3)std::printf("BAD t=%d slot=%d col=%d actual=%g ref=%g\n",t,slot,col,actual,ref);++bad;}
+    }
+    double rel=std::sqrt(e2/std::max(r2,1e-30));
+    std::printf("GGML %s broadcast=%d tokens=%d n=%d k=%d strided_a=%d strided_out=%d relative_rmse=%g bad=%d\n",moe?"MUL_MAT_ID":"MUL_MAT",broadcast,tokens,n,k,strided_a,strided_out,rel,bad);
+    ggml_backend_buffer_free(buffer);ggml_free(ctx);ggml_backend_free(backend);
+    if(bad||rel>(fallback?.025:.001))throw std::runtime_error("GGML CUDA integration numeric test failed");
+}
+int main(int argc,char**argv){try{if(argc>1 && !std::strcmp(argv[1],"--unsupported-shape")){run(false,false,17,96,64,false,false,true);return 0;}run(false,false,1,64,128);run(false,false,17,128,64);run(false,false,71,256,512);run(true,true,1,64,128);run(true,true,35,128,64);run(true,false,35,64,128);run(false,false,17,64,128,true,true);run(true,true,17,64,128,true,true);run(true,false,17,64,128,true,true);const char * policy=std::getenv("GGML_CUDA_NVFP4_KERNEL");if(!policy||!std::strcmp(policy,"auto")||!std::strcmp(policy,"ggml"))run(false,false,17,96,64,false,false,true);std::puts("PASS: GGML CUDA Dense/MoE + external scale, gate/up broadcast and down expert channels");}catch(const std::exception&e){std::fprintf(stderr,"%s\n",e.what());return 1;}}

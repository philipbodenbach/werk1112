+        ggml_cuda_mul_mat_q(ctx,w,a,ids,c);
+        return true;
+    }
+    if(policy==werk_policy::native) GGML_ABORT("WERK: native NVFP4 is unsupported for this device/build/tensor layout (%s)",w->name);

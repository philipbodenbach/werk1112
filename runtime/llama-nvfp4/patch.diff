+#include "werk-marlin.cuh"
+#include <vector>
+#include <cmath>
+#include <cstdio>
+#include <stdexcept>
+#include <algorithm>
+#include <cstdlib>
+#define CUDA(call) do { auto status=(call); if(status!=cudaSuccess) throw std::runtime_error(cudaGetErrorString(status)); } while(0)
+template<class T> struct device { T * p=nullptr; device(size_t n){ CUDA(cudaMalloc(&p,n*sizeof(T))); } ~device(){cudaFree(p);} };
+static float f4(int q) { const float values[]={0,.5,1,1.5,2,3,4,6}; return values[q&7]*(q&8?-1:1); }
+static float f8(int q) { return q<8?std::ldexp(float(q),-9):std::ldexp(1.0f+float(q&7)/8,(q>>3)-7); }
+static void test(int m,int n,int k,bool moe,bool tiny,int stress=0) {
+    int experts=moe?4:1,sms=0;CUDA(cudaDeviceGetAttribute(&sms,cudaDevAttrMultiProcessorCount,0));
+    std::vector<int> boundaries=moe?std::vector<int>{0,0,m/3,m,m}:std::vector<int>{0,m};
+    std::vector<werk_nvfp4_block> w(size_t(experts)*n*k/64);
+    std::vector<werk_activation> a(size_t(m)*k); std::vector<float> result(size_t(m)*n);
+    for(size_t i=0;i<a.size();++i) a[i]=__float2bfloat16(stress ? (stress==1?1.0f:131072.0f) : tiny?1.0f:float(int((i*37+13)%101)-50)/1000);
+    for(size_t b=0;b<w.size();++b) {
+        for(int g=0;g<4;++g)w[b].d[g]=stress?119:tiny?1:uint8_t((b*13+g*23)%120);
+        for(int q=0;q<32;++q)w[b].qs[q]=stress?0x77:tiny?0x11:uint8_t((b*19+q*43+7)%256);
+    }
+    device<werk_nvfp4_block> wd(w.size());device<werk_activation> ad(a.size()),sd(size_t(n)*k/16);device<float> cd(result.size());
+    device<uint32_t> bd(size_t(n)*k/8);device<float> tmp(size_t(sms)*16*256);device<int> locks(sms),bounds(boundaries.size());
+    CUDA(cudaMemcpy(wd.p,w.data(),w.size()*sizeof(w[0]),cudaMemcpyHostToDevice));
+    CUDA(cudaMemcpy(ad.p,a.data(),a.size()*sizeof(werk_activation),cudaMemcpyHostToDevice));
+    CUDA(cudaMemcpy(bounds.p,boundaries.data(),boundaries.size()*sizeof(int),cudaMemcpyHostToDevice));
+    CUDA(cudaMemset(locks.p,0,sms*sizeof(int)));CUDA(cudaMemset(cd.p,0xff,result.size()*sizeof(float)));
+    for(int e=0;e<experts;++e) {
+        werk_marlin_repack(wd.p+size_t(e)*n*k/64,bd.p,sd.p,n,k,moe?bounds.p:nullptr,e,0);
+        werk_marlin_mm(ad.p,bd.p,sd.p,cd.p,tmp.p,locks.p,m,n,k,sms,moe?bounds.p:nullptr,e,0);
+    }
+    CUDA(cudaGetLastError());CUDA(cudaDeviceSynchronize());
+    CUDA(cudaMemcpy(result.data(),cd.p,result.size()*sizeof(float),cudaMemcpyDeviceToHost));
+    double err2=0,ref2=0;float maxerr=0;int bad=0;
+    for(int row=0;row<m;++row)for(int col=0;col<n;++col){
+        int expert=0;if(moe)while(row>=boundaries[expert+1])++expert;
+        double ref=0;
+        for(int j=0;j<k;++j){
+            auto & block=w[(size_t(expert)*n+col)*(k/64)+j/64];
+            int qj=j%64,q=(block.qs[qj/16*8+qj%8]>>((qj%16/8)*4))&15;
+            ref+=double(__bfloat162float(a[size_t(row)*k+j]))*f4(q)*f8(block.d[qj/16]);
+        }
+        float actual=result[size_t(row)*n+col];double err=std::abs(actual-ref);
+        if(!std::isfinite(actual)||err>.025+.001*std::abs(ref)){if(bad<3)std::printf("BAD row=%d col=%d got=%g ref=%g\n",row,col,actual,ref);++bad;}
+        maxerr=std::max(maxerr,float(err));err2+=err*err;ref2+=ref*ref;
+    }
+    double rel=std::sqrt(err2/std::max(ref2,1e-30));
+    std::printf("%s m=%d n=%d k=%d tiny=%d stress=%d max_error=%g relative_rmse=%g bad=%d\n",moe?"moe":"dense",m,n,k,tiny,stress,maxerr,rel,bad);
+    if(bad || rel>0.001)throw std::runtime_error("Marlin numeric comparison failed");
+}
+int main(){
+    try {
+        for(int m:{1,7,16,17,33,128})test(m,64,128,false,false);
+        test(97,128,64,false,false);test(71,256,512,false,false);test(257,1024,128,false,false);test(521,512,128,true,false);
+        test(35,64,128,true,false);test(97,128,64,true,false);
+        test(3,64,128,false,true);test(35,64,128,true,true);test(1,64,8192,false,false);test(1,64,8192,false,false,1);test(3,64,8192,true,false,2);
+        std::puts("PASS: FP32 reference, partial tiles, both layouts, empty experts and subnormal scales");
+    }catch(const std::exception&e){std::fprintf(stderr,"%s\n",e.what());return 1;}
+}

+    const bool marlin=layout && device && ggml_is_contiguous(w) && werk_marlin_shape(w->ne[1],w->ne[0]) &&
+        w->ne[3]==1 && a->ne[3]==1 && (ids || (w->ne[2]==1 && a->ne[2]==1)) &&
+        (!ids || a->ne[2]*ids->ne[0]<=INT_MAX);
+    if(!marlin) {
+        if(policy==werk_policy::marlin) GGML_ABORT("WERK: Marlin NVFP4 is unsupported for this device/build/tensor layout (%s): require SM80+, contiguous weights, K%%128=N%%64=0 or K%%64=N%%128=0",w->name);
+        return false;
+    }
+    const int n=w->ne[1], k=w->ne[0], m=ids ? a->ne[2]*ids->ne[0] : a->ne[1];
+    const int experts=ids ? w->ne[2] : 1;
+    cudaStream_t stream=ctx.stream();
+    int sms=0;
+    CUDA_CHECK(cudaDeviceGetAttribute(&sms,cudaDevAttrMultiProcessorCount,ctx.device));
+    ggml_cuda_pool_alloc<werk_activation> ah(ctx.pool(),size_t(m)*k);
+    ggml_cuda_pool_alloc<float> ch(ctx.pool(),size_t(m)*n);
+    ggml_cuda_pool_alloc<uint32_t> packed(ctx.pool(),size_t(n)*k/8);
+    ggml_cuda_pool_alloc<werk_activation> scales(ctx.pool(),size_t(n)*k/16);
+    ggml_cuda_pool_alloc<float> reduce(ctx.pool(),size_t(sms)*16*256);
+    ggml_cuda_pool_alloc<int> locks(ctx.pool(),sms);
+    ggml_cuda_pool_alloc<int> rows(ctx.pool()), dest(ctx.pool()), bounds(ctx.pool());
+    CUDA_CHECK(cudaMemsetAsync(locks.get(),0,size_t(sms)*sizeof(int),stream));
+    if(ids) {
+        rows.alloc(m);dest.alloc(m);bounds.alloc(experts+1);
+        ggml_cuda_launch_mm_ids_helper((const int*)ids->data,rows.get(),dest.get(),bounds.get(),
+            experts,a->ne[2],ids->ne[0],a->ne[1],ids->nb[1]/sizeof(int),a->nb[2]/a->nb[1],false,stream);
+    }
+    werk_gather<<<(size_t(m)*k+255)/256,256,0,stream>>>((const char*)a->data,ah.get(),rows.get(),m,k,a->nb[1]);
+    for(int e=0;e<experts;++e) {
+        const auto * weight=(const werk_nvfp4_block*)((const char*)w->data+size_t(e)*w->nb[2]);
+        werk_marlin_repack(weight,packed.get(),scales.get(),n,k,bounds.get(),e,stream);
+        werk_marlin_mm(ah.get(),packed.get(),scales.get(),ch.get(),reduce.get(),locks.get(),m,n,k,sms,bounds.get(),e,stream);
+    }
+    const int used=ids ? ids->ne[0] : 1;
+    werk_scatter<<<(size_t(m)*n+255)/256,256,0,stream>>>(ch.get(),(char*)c->data,dest.get(),m,n,used,c->nb[1],ids ? c->nb[2] : c->nb[1]);
